        {"id": "issue_2", "title_zh": "材料方案", "title_en": "Materials plan", "tasks": ["建議鋼種/清潔度", "連結顯微組織同宏觀斷裂"]},
        {"id": "issue_3", "title_zh": "構造與驗證", "title_en": "Detailing & verification", "tasks": ["一項節點構造改善", "NDT/試驗驗證"]}
